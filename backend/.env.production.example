# ---------------------------------------------------------------------------
# Production / staging configuration. Copy to .env on the deploy target only.
# backend/.env is for LOCAL DEVELOPMENT and must never point here.
# ---------------------------------------------------------------------------

SECRET_KEY=<generate with: python -c "import secrets;print(secrets.token_urlsafe(48))">

# DATABASE
#
# Two facts about this project's Supabase endpoints, both learned the hard way:
#
#  1. The DIRECT endpoint (db.<ref>.supabase.co:5432) resolves over IPv6 ONLY —
#     `dig A db.<ref>.supabase.co` returns nothing at all. Any host without
#     IPv6 egress cannot connect, full stop. That rules out most CI runners
#     and most free-tier deploy targets. It is a connectivity blocker long
#     before it is a latency concern.
#
#  2. Production therefore belongs on the Supavisor pooler, which resolves
#     over IPv4 and terminates TLS at the edge:
#
#       postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
#     Port 6543 is the transaction pooler (use NullPool in the app — Supavisor
#     owns pooling). Port 5432 on the same host is the session pooler.
#
# Direct endpoint, kept for reference only — do not use from a deploy target:
#   postgresql://postgres:<password>@db.rislfqksqyiliurzbczp.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres.rislfqksqyiliurzbczp:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

BACKEND_CORS_ORIGINS=["https://<your-frontend-host>"]

SUPABASE_URL=https://rislfqksqyiliurzbczp.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role key from Supabase dashboard > Settings > API>
SUPABASE_STORAGE_BUCKET=doc-portal-files
