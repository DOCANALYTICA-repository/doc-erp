# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start if this is unset — there is no hardcoded fallback.
SECRET_KEY=

# Local dev default (SQLite). For staging/production, set this to a real
# Supabase/Postgres connection string, e.g.:
# postgresql://postgres:<password>@<project>.supabase.co:5432/postgres
DATABASE_URL=sqlite:///./doc_platform.db

# JSON array of allowed frontend origins. Never combine "*" with credentials.
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# Supabase Storage. Leave both blank for local development: the storage
# engine then writes uploads to backend/var/uploads and serves them back
# through signed /api/v1/files links. Set both to use the real bucket.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=doc-portal-files

# --- Demo personas ------------------------------------------------------------
# Password-free sign-in as a seeded account. This is IMPERSONATION and must
# stay false outside local development. Set explicitly rather than relying on
# the default, so the intent is visible in the deployed config.
ENABLE_DEMO_PERSONAS=false
