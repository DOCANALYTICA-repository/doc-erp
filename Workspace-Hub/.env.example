# ---------------------------------------------------------------------------
# Workspace-Hub (frontend) configuration.
# Copy to .env.local for development, or set these in your deploy target.
#
# Vite only exposes variables prefixed VITE_ to client code. Never put a
# secret here — everything in this file is readable in the shipped bundle.
# ---------------------------------------------------------------------------

# Where the API lives, including the /api/v1 suffix.
#
# Leave unset in development: Vite's dev server proxies /api/v1 to the local
# backend, so the relative default works.
#
# A PRODUCTION BUILD REQUIRES THIS unless the app is served behind a reverse
# proxy on the same origin as the API — the app throws at startup otherwise,
# rather than issuing a wall of 404s that look like backend failures.
VITE_API_BASE_URL=http://localhost:8000/api/v1
